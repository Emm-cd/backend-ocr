# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo, renómbralo a .env 
# y coloca tus credenciales reales.
# ==========================================

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto-ejemplo.supabase.co
SUPABASE_KEY=tu_clave_anonima_aqui
SUPABASE_SERVICE_KEY=tu_service_key_aqui_si_la_usas

# Configuración de IA (Groq)
GROQ_API_KEY=tu_api_key_de_groq_aqui

#Configuración de N8N 
N8N_WEBHOOK_URL=https://tu-url-de-webhook-de-n8n-aqui

# Configuraciones adicionales (si tienes alguna otra)
PORT=8000
DEBUG=True